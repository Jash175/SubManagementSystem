# =============================================================================
# Brightloop Subscription Management System — Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or production secrets to Git.
#
# Vercel Deployment: Configure these exact environment variables in your
# Vercel Project Settings -> Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application URL
# -----------------------------------------------------------------------------
# The canonical public origin of the application.
# Local: http://localhost:3000
# Vercel Production: https://your-app-name.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. Supabase Configuration (Client & Server)
# -----------------------------------------------------------------------------
# Obtain from: Supabase Dashboard -> Project Settings -> API
#
# NEXT_PUBLIC_SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
# Required: YES
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:
# Your Supabase 'anon' public key. Safe to expose to the browser; protected by RLS.
# Required: YES
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# 3. Supabase Service Role Key (SERVER-ONLY — HIGH PRIVILEGE)
# -----------------------------------------------------------------------------
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role
#
# WARNING: NEVER prefix this variable with NEXT_PUBLIC_.
# This key bypasses Row-Level Security and is strictly accessed server-side for:
# - Admin staff account provisioning (/staff)
# - Background recurring billing run execution (/api/v1/billing/run)
# Required: YES (for staff provisioning & automated billing)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# 4. Transactional Email Delivery (Resend - Optional)
# -----------------------------------------------------------------------------
# Obtain from: https://resend.com/api-keys
# Required: Optional (emails log to server console if not provided)
RESEND_API_KEY=re_your_resend_api_key_here
INVOICE_FROM_EMAIL=billing@brightloop.local

# -----------------------------------------------------------------------------
# 5. Scheduled Recurring Billing Protection (Server-Only)
# -----------------------------------------------------------------------------
# Shared secret token for protecting the POST /api/v1/billing/run endpoint
# when triggered by Vercel Cron or external schedulers.
# Set an arbitrary secure random string (e.g. openssl rand -hex 32).
# Required: Optional for manual admin UI runs; Recommended for production cron.
CRON_SECRET=your-random-cron-secret-token
